<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MMUST Shop</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
        }
        .shop-box {
            border: 2px solid black;
            padding: 30px 50px;
            text-align: center;
            line-height: 1.8;
        }
        h1 {
            margin: 0;
            font-size: 22px;
            font-weight: normal;
        }
        .subtitle {
            margin: 5px 0;
            font-size: 18px;
        }
        .quote {
            margin: 5px 0 0 0;
            font-size: 16px;
        }
    </style>
</head>
<body>

    <div class="shop-box">
        <h1>MMUST SHOP</h1>
        <div class="subtitle">BUY & SELL</div>
        <div class="quote">"Anything"</div>
    </div>

</body>
</html>
